<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
        <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <!--
            Samples-only: design-time tooling for `dotnet ef`. Unconditioned, not per-TFM like the
            EF Core packages below, because the samples project is single-targeted (net10.0 only,
            via its own TargetFramework), and its TargetFramework isn't set yet when a per-TFM
            Condition here would need to see it.
        -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    </ItemGroup>

    <!--
        One EF Core major per target framework: each TFM's build of the library is compiled (and
        tested) against the EF Core major that ships for it, so the package's dependency group for
        that TFM pulls the matching EF Core. The providers are test-only: tests build every model
        on each of them (no database needed) to prove the rules are provider-neutral. MySQL is
        Oracle's MySql.EntityFrameworkCore: Pomelo has no EF Core 10 or 11 release yet (add it
        back per target framework once it has). Sqlite.Core plus an explicit
        SQLitePCLRaw bundle rather than the Sqlite package: the provider loads native SQLite even
        just to build a model, and the bundle the Sqlite package pulls in (2.1.6-2.1.11) ships a
        known-vulnerable SQLite.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.12" />
        <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
        <!--
            Test-only, never packed: the SqlServer provider pulls in Pkcs 9.0.11 through
            Microsoft.Data.SqlClient 6.1.x, which NuGet audit fails (GHSA-846f-f764-76mx,
            GHSA-2fmv-rv2c-59x7; patched in 9.0.21). net10.0 only: the EF Core 11 provider's
            SqlClient doesn't pull it in. Drop it once the provider's SqlClient depends on 9.0.21
            or later.
        -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="11.0.0" />
        <!--
            Test-only, never packed, so a prerelease is fine here: Npgsql and Oracle's MySQL
            provider have no stable EF Core 11 release yet. Move them to stable once they ship.
        -->
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
        <PackageVersion Include="MySql.EntityFrameworkCore" Version="11.0.0-preview" />
    </ItemGroup>
</Project>
