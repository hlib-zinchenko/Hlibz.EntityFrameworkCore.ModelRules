# xUnit Assertion Analyzers (2xxx)

# xUnit2000: Constants and literals should be the expected argument
dotnet_diagnostic.xUnit2000.severity = error

# xUnit2001: Do not use invalid equality check
dotnet_diagnostic.xUnit2001.severity = error

# xUnit2002: Do not use null check on value type
dotnet_diagnostic.xUnit2002.severity = error

# xUnit2003: Do not use equality check to test for null value
dotnet_diagnostic.xUnit2003.severity = error

# xUnit2004: Do not use equality check to test for boolean conditions
dotnet_diagnostic.xUnit2004.severity = error

# xUnit2005: Do not use identity check on value type
dotnet_diagnostic.xUnit2005.severity = error

# xUnit2006: Do not use invalid string equality check
dotnet_diagnostic.xUnit2006.severity = error

# xUnit2007: Do not use typeof expression to check the type
dotnet_diagnostic.xUnit2007.severity = error

# xUnit2008: Do not use boolean check to match on regular expressions
dotnet_diagnostic.xUnit2008.severity = error

# xUnit2009: Do not use boolean check to check for substrings
dotnet_diagnostic.xUnit2009.severity = error

# xUnit2010: Do not use boolean check to check for string equality
dotnet_diagnostic.xUnit2010.severity = error

# xUnit2011: Do not use empty collection check
dotnet_diagnostic.xUnit2011.severity = error

# xUnit2012: Do not use Enumerable.Any() to check if a value exists in a collection
dotnet_diagnostic.xUnit2012.severity = error

# xUnit2013: Do not use equality check to check for collection size
dotnet_diagnostic.xUnit2013.severity = error

# xUnit2014: Do not use throws check to check for asynchronously thrown exception
dotnet_diagnostic.xUnit2014.severity = error

# xUnit2015: Do not use typeof expression to check the exception type
dotnet_diagnostic.xUnit2015.severity = error

# xUnit2016: Keep precision in the allowed range when asserting equality of doubles or decimals
dotnet_diagnostic.xUnit2016.severity = error

# xUnit2017: Do not use Contains() to check if a value exists in a collection
dotnet_diagnostic.xUnit2017.severity = error

# xUnit2018: Do not compare an object's exact type to an abstract class or interface
dotnet_diagnostic.xUnit2018.severity = error

# xUnit2019: Do not use obsolete throws check to check for asynchronously thrown exception
# Does not apply to xUnit.net v3
# dotnet_diagnostic.xUnit2019.severity = error

# xUnit2020: Do not use always-failing boolean assertion to fail a test
dotnet_diagnostic.xUnit2020.severity = error

# xUnit2021: Async assertions should be awaited
dotnet_diagnostic.xUnit2021.severity = error

# xUnit2022: Boolean assertions should not be negated
dotnet_diagnostic.xUnit2022.severity = error

# xUnit2023: Do not use collection methods for single-item collections
dotnet_diagnostic.xUnit2023.severity = error

# xUnit2024: Do not use boolean asserts for simple equality tests
dotnet_diagnostic.xUnit2024.severity = error

# xUnit2025: The boolean assertion statement can be simplified
dotnet_diagnostic.xUnit2025.severity = error

# xUnit2026: Comparison of sets must be done with IEqualityComparer
dotnet_diagnostic.xUnit2026.severity = error

# xUnit2027: Comparison of sets to linear containers have undefined results
dotnet_diagnostic.xUnit2027.severity = error

# xUnit2028: Do not use Assert.Empty or Assert.NotEmpty with problematic types
dotnet_diagnostic.xUnit2028.severity = error

# xUnit2029: Do not use Assert.Empty to check if a value does not exist in a collection
dotnet_diagnostic.xUnit2029.severity = error

# xUnit2030: Do not use Assert.NotEmpty to check if a value exists in a collection
dotnet_diagnostic.xUnit2030.severity = error

# xUnit2031: Do not use Where clause with Assert.Single
dotnet_diagnostic.xUnit2031.severity = error

# xUnit2032: Type assertions based on 'assignable from' are confusingly named
dotnet_diagnostic.xUnit2032.severity = error

# xUnit Extensibility Analyzers (3xxx)

# xUnit3000: Classes which cross AppDomain boundaries must derive from LongLivedMarshalByRefObject
# Does not apply to xUnit.net v3
# dotnet_diagnostic.xUnit3000.severity = error

# xUnit3001: Serializable or runtime-created classes must have a public parameterless constructor
dotnet_diagnostic.xUnit3001.severity = error

# xUnit3002: JSON serializable classes should not be tested for their concrete type
dotnet_diagnostic.xUnit3002.severity = error

# xUnit3003: Classes extending FactAttribute should provide a public constructor for source info
dotnet_diagnostic.xUnit3003.severity = error

# CA1000: Do not declare static members on generic types — common pattern for Result<T>/PagedData<T>-style helpers
dotnet_diagnostic.CA1000.severity = none

# CA1034: Nested types should not be visible — every module's FieldsLengthLimitations groups related constants
dotnet_diagnostic.CA1034.severity = none

# CA1040: Avoid empty interfaces — marker interfaces (IRequest, IEntity, IValueObject, I<Module>UnitOfWork) are load-bearing
dotnet_diagnostic.CA1040.severity = none

# CA1711: Identifiers should not have incorrect suffix — "Stream" is fixed domain vocabulary (IncomeStream)
dotnet_diagnostic.CA1711.severity = none

# S2094: Remove this empty class — AssemblyMarker is a required reflection-discovery marker per module
dotnet_diagnostic.S2094.severity = none

# Tests: no XML docs, underscores in test names.
[tests/**.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA2234.severity = none
